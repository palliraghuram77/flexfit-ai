# For local testing with the Netlify CLI (`netlify dev`), copy this file to
# `.env` and fill in your real keys - `.env` is already gitignored.
#
# For the live site, set these in Netlify's dashboard instead:
# Site configuration -> Environment variables -> Add a variable.
# Never commit a real key to this repo.

# Main food scanner (free key from console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
# Optional: Groq vision model to try first (default qwen/qwen3.8-27b)
# GROQ_MODEL=qwen/qwen3.8-27b

# Fallback for the scanner + used by Jiya chat
GEMINI_API_KEY=your-gemini-api-key-here
