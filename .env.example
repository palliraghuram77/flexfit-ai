# For local testing with the Netlify CLI (`netlify dev`), copy this file to
# `.env` and fill in your real key - `.env` is already gitignored.
#
# For the live site, set this in Netlify's dashboard instead:
# Site settings -> Environment variables -> Add a variable.
# Never commit a real key to this repo.

GEMINI_API_KEY=your-gemini-api-key-here
